import {
  "moonrockz/moonspec",
  "moonrockz/moonspec/format",
  "moonbitlang/async",
}

rule(
  name: "moonspec-tests",
  command: "moonspec gen tests $input -w TodoWorld -o $output",
)

rule(name: "moonspec-steps", command: "moonspec gen steps -d src")

dev_build(
  rule: "moonspec-tests",
  input: "../features/todolist.feature",
  output: "todolist_feature_wbtest.mbt",
)

dev_build(
  rule: "moonspec-steps",
  input: "steps.mbt",
  output: "todoworld_steps_gen.mbt",
)
