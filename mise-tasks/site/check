#!/usr/bin/env bash
#MISE description="Test the site packages, build the release and next versions, and check them"
set -euo pipefail

(cd site && moon test --target native && moon test --target js && moon check --target native && moon check --target js)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
release=$(mise run site:latest-tag)
release=${release:-v0.0.0}

mise run site:build -- --content . --channel release --site-root /moonspec/ \
  --release-version "$release" --ref "$release" --out "$tmp/site"
mise run site:build -- --content . --channel next --site-root /moonspec/ \
  --release-version "$release" --ref main --out "$tmp/site/next"
mise run site:linkcheck -- --dist "$tmp/site" --base /moonspec/ --ignore /moonspec/next/
mise run site:linkcheck -- --dist "$tmp/site/next" --base /moonspec/next/
