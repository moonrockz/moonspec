pub fn StepValue::to_string(Self) -> String
pub impl Eq for StepValue
pub impl Show for StepValue
pub impl @debug.Debug for StepValue

// Type aliases

// Traits
pub trait Attachable {
  fn attach(Self, String, String, file_name? : String) -> Unit
  fn attach_bytes(Self, Bytes, String, file_name? : String) -> Unit
  fn attach_url(Self, String, String) -> Unit
  fn pending_attachments(Self) -> Array[PendingAttachment]
}

pub(open) trait FromStepArg {
  fn from_step_arg(StepArg) -> Self raise
}
pub impl FromStepArg for Byte
pub impl FromStepArg for Int
pub impl FromStepArg for Int64
pub impl FromStepArg for Double
pub impl FromStepArg for String
pub impl FromStepArg for @bigint.BigInt
pub impl FromStepArg for @decimal.Decimal

pub(open) trait MessageSink {
  fn on_message(Self, @cucumber-messages.Envelope) -> Unit
  fn output(Self) -> String
}

pub(open) trait StepLibrary {
  fn steps(Self) -> ArrayView[StepDef]
}

pub(open) trait World {
  fn configure(Self, Setup) -> Unit raise
}
