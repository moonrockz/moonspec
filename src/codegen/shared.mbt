///|
/// A complete feature input, including the original URI and full Markdown source.
pub(all) struct FeatureInput {
  uri : String
  content : String
  mode : CodegenMode
}

///|
/// One relative output beneath moonspec_gen.
pub(all) struct PlannedFile {
  path : String
  content : String
}

///|
/// A validated, deterministic output tree. Filesystem checks precede application.
pub struct GenerationPlan {
  priv outputs : Array[PlannedFile]
}

///|
pub fn GenerationPlan::files(self : GenerationPlan) -> Array[PlannedFile] {
  self.outputs.copy()
}

///|
pub(all) suberror PlanError {
  InvalidPlan(String)
} derive(Debug)

///|
pub extend PlanError with @moonbitlang/core/debug.Debug::{to_repr}

///|
/// Plan shared source and target-specific entry packages without host effects.
/// package_path is relative to the module's configured source directory.
pub fn plan_shared_generation(
  features : Array[FeatureInput],
  module_name~ : String,
  package_path~ : String,
  config~ : CodegenConfig,
  test_kind~ : @config.TestKind = WhiteBox,
) -> GenerationPlan raise PlanError {
  for segment in package_path.split("/") {
    if segment.has_prefix("_") || segment.has_prefix(".") {
      raise InvalidPlan(
        "output package path must be compiler-visible: " + package_path,
      )
    }
  }
  let shared = match config.shared {
    Some(shared) => shared
    None =>
      raise InvalidPlan(
        "object execution requires shared package/world_factory/options_factory",
      )
  }
  shared.validate() catch {
    @config.InvalidExecution(message) => raise InvalidPlan(message)
  }
  @config.SharedConfig::{ ..shared, package_path: module_name, }.validate() catch {
    @config.InvalidExecution(message) =>
      raise InvalidPlan("module_name: " + message)
  }
  if !package_path.is_empty() {
    @config.SharedConfig::{ ..shared, package_path, }.validate() catch {
      @config.InvalidExecution(message) =>
        raise InvalidPlan("package_path: " + message)
    }
  }
  if shared.package_path != module_name &&
    !shared.package_path.has_prefix(module_name + "/") {
    raise InvalidPlan(
      "shared.package must belong to the current module " + module_name,
    )
  }
  let common_package = module_name +
    (if package_path.is_empty() { "" } else { "/" + package_path }) +
    "/moonspec_gen/shared"
  let outputs : Array[PlannedFile] = []
  let common = StringBuilder()
  common.write_string("// Generated by moonspec shared codegen. DO NOT EDIT.\n")
  let documents : Array[@gherkin.GherkinDocument] = []
  for input in features {
    let doc = @gherkin.parse(
      @gherkin.Source::from_string(input.content, uri=input.uri),
    ) catch {
      _ => raise InvalidPlan("Failed to parse feature " + input.uri)
    }
    if doc.feature is Some(feature) {
      for child in feature.children {
        if child is @gherkin.FeatureChild::Scenario(scenario) {
          for examples in scenario.examples {
            if examples.table_header is Some(header) {
              for row in examples.table_body {
                if row.cells.length() != header.cells.length() {
                  raise InvalidPlan(
                    "inconsistent Examples table in " + input.uri,
                  )
                }
              }
            }
          }
        }
      }
    }
    documents.push(doc)
  }
  for i, input in features {
    common.write_string(
      "\n///|\npub fn options_" +
      i.to_string() +
      "() -> @moonspec.RunOptions {\n" +
      "  let options = @definitions." +
      shared.options_factory +
      "([@moonspec.FeatureSource::Text(\"" +
      escape_string(input.uri) +
      "\", \"" +
      escape_string(input.content) +
      "\")])\n",
    )
    if config.no_color {
      common.write_string("  options.no_color(true)\n")
    }
    generate_skip_tags_line(common, None, { ..config, shared: None, })
    if config.formatters is Some(_) {
      generate_formatter_lines(common, config)
    }
    common.write_string("  options\n}\n")
  }
  outputs.push({ path: "shared/sources.mbt", content: common.to_string(), })
  outputs.push({
    path: "shared/moon.pkg",
    content: "// Generated by moonspec shared codegen. DO NOT EDIT.\nimport {\n  \"moonrockz/moonspec\",\n  \"" +
    shared.package_path +
    "\" @definitions,\n" +
    (if config.formatters is Some(formatters) && !formatters.is_empty() {
      "  \"moonrockz/moonspec/format\",\n"
    } else {
      ""
    }) +
    "}\nsupported_targets = \"wasm+wasm-gc+js+native\"\n",
  })
  for mode in [@config.ExecutionMode::Sync, Async] {
    let targets = [@config.Target::Wasm, WasmGc, Js, Native].filter(fn(target) {
      config.execution.resolve(target) == mode &&
      !(config.execution is Scalar(Async) && target == WasmGc)
    })
    if targets.is_empty() {
      continue
    }
    if mode == Async && targets.contains(WasmGc) {
      raise InvalidPlan(
        "execution async is unsupported on wasm-gc; select sync explicitly",
      )
    }
    let directory = match mode {
      Sync => "sync"
      Async => "async"
    }
    let facade = match mode {
      Sync => "moonrockz/moonspec"
      Async => "moonrockz/moonspec/async"
    }
    let kind = match test_kind {
      WhiteBox => "wbtest"
      BlackBox => "test"
    }
    let runtime = match mode {
      Sync => ""
      Async => "  \"moonbitlang/async\" @async_runtime,\n"
    }
    outputs.push({
      path: directory + "/moon.pkg",
      content: "// Generated by moonspec shared codegen. DO NOT EDIT.\nimport {\n  \"" +
      facade +
      "\" @moonspec,\n  \"" +
      common_package +
      "\" @sources,\n  \"" +
      shared.package_path +
      "\" @definitions,\n" +
      runtime +
      "} for \"" +
      kind +
      "\"\nsupported_targets = \"" +
      targets.map(t => t.name()).join("+") +
      "\"\n",
    })
    for i, input in features {
      let buf = StringBuilder()
      buf.write_string(
        "// Generated by moonspec shared codegen. DO NOT EDIT.\n// Source: " +
        input.uri +
        "\n",
      )
      let selected = {
        ..config,
        execution: Scalar(mode),
        mode: input.mode,
        world: "shared",
        no_color: false,
      }
      let source_expr = "@sources.options_" + i.to_string() + "()"
      if documents[i].feature is Some(feature) {
        match input.mode {
          PerFeature =>
            generate_per_feature(buf, feature, source_expr, selected)
          PerScenario =>
            generate_per_scenario(
              buf,
              feature,
              input.uri,
              source_expr,
              selected,
            )
        }
      }
      let mut filename_uri = input.uri
      while filename_uri.has_prefix("./") {
        filename_uri = filename_uri[2:].to_owned()
      }
      let path = directory +
        "/" +
        feature_to_test_filename(filename_uri, kind=test_kind)
      if outputs.any(fn(file) { file.path == path }) {
        raise InvalidPlan("generated output collision: " + path)
      }
      outputs.push({ path, content: buf.to_string(), })
    }
  }
  { outputs, }
}
