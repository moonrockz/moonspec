///|
/// First line of every file that `gen steps` writes.
let generated_header = "// Generated by moonspec gen steps — DO NOT EDIT"

///|
/// Generate a `configure` impl block for the given world type and step functions.
pub fn generate_configure(
  world_type : String,
  steps : Array[StepFnInfo],
  source_hash~ : String,
) -> String {
  let buf = StringBuilder()
  buf.write_string(generated_header + "\n")
  buf.write_string("// moonspec:hash:" + source_hash + "\n")
  buf.write_string("\n")
  // Only the generated tests use the impl, so non-test code reports it as
  // unused. A `pub impl` would fail for a `priv` world type.
  buf.write_string("#warnings(\"-unused_value\")\n")
  buf.write_string(
    "impl @moonspec.World for " +
    world_type +
    " with configure(self, setup) {\n",
  )
  for step in steps {
    generate_step_registration(buf, step)
  }
  buf.write_string("}\n")
  buf.to_string()
}

///|
/// Highest arity of the typed `Setup` methods, with and without `Ctx`
/// (`given0` .. `given22`, `given0_ctx` .. `given22_ctx`).
let max_typed_arity = 22

///|
/// How a step function is registered, from the shape of its parameters
/// after the world parameter.
priv enum Registration {
  /// Typed parameters only: `setup.given2("...", fn(a : A, b : B) { ... })`.
  Typed(Array[ParamInfo])
  /// Typed parameters (up to 22), then `Ctx`:
  /// `setup.given1_ctx("...", fn(a : A, ctx) { ... })`.
  TypedCtx(Array[ParamInfo])
  /// Only `Ctx`: a handler that reads the arguments from `ctx` itself.
  Handler
  /// Too many typed parameters for a typed method. The arguments are
  /// decoded from `ctx` with `FromStepArg`; `takes_ctx` passes `ctx` on.
  Decoded(Array[ParamInfo], takes_ctx~ : Bool)
}

///|
/// Whether a parameter type is the step context, written `Ctx` or
/// `@pkg.Ctx` (for example `@moonspec.Ctx`).
fn is_ctx_type(type_name : String) -> Bool {
  type_name == "Ctx" || type_name.has_suffix(".Ctx")
}

///|
fn registration(step : StepFnInfo) -> Registration {
  let params = step.params
  let takes_ctx = match params.last() {
    Some(last) => is_ctx_type(last.type_name)
    None => false
  }
  let typed = if takes_ctx {
    params[:params.length() - 1].to_owned()
  } else {
    params
  }
  match (typed.length(), takes_ctx) {
    (0, true) => Handler
    (n, true) if n <= max_typed_arity => TypedCtx(typed)
    (n, false) if n <= max_typed_arity => Typed(typed)
    _ => Decoded(typed, takes_ctx~)
  }
}

///|
fn generate_step_registration(buf : StringBuilder, step : StepFnInfo) -> Unit {
  match registration(step) {
    Typed(typed) => generate_typed_step(buf, step, typed, takes_ctx=false)
    TypedCtx(typed) => generate_typed_step(buf, step, typed, takes_ctx=true)
    Handler => generate_handler_step(buf, step)
    Decoded(typed, takes_ctx~) =>
      generate_decoded_step(buf, step, typed, takes_ctx~)
  }
}

///|
/// The `raise` part of a lambda that calls the step function. A lambda that
/// calls a raising function must say so explicitly; effect inference for
/// `fn` lambdas is deprecated.
fn lambda_effect(step : StepFnInfo) -> String {
  if step.raises {
    " raise"
  } else {
    ""
  }
}

///|
/// Write `fn_name(self, _arg0, ..., _argN[, ctx])`.
fn write_step_call(
  buf : StringBuilder,
  step : StepFnInfo,
  arity : Int32,
  takes_ctx~ : Bool,
) -> Unit {
  buf.write_string("    " + step.fn_name + "(self")
  for i = 0; i < arity; i = i + 1 {
    buf.write_string(", _arg" + i.to_string())
  }
  if takes_ctx {
    buf.write_string(", ctx")
  }
  buf.write_string(")\n")
  buf.write_string("  })\n")
}

///|
/// Generate a typed arity-suffixed step registration, such as `given2` or,
/// with `takes_ctx`, `given2_ctx`.
fn generate_typed_step(
  buf : StringBuilder,
  step : StepFnInfo,
  typed : Array[ParamInfo],
  takes_ctx~ : Bool,
) -> Unit {
  let suffix = if takes_ctx { "_ctx" } else { "" }
  buf.write_string(
    "  setup." +
    step.keyword +
    typed.length().to_string() +
    suffix +
    "(\"" +
    escape_pattern(step.pattern) +
    "\", fn(",
  )
  for i, param in typed {
    if i > 0 {
      buf.write_string(", ")
    }
    buf.write_string("_arg" + i.to_string() + " : " + param.type_name)
  }
  if takes_ctx {
    if typed.length() > 0 {
      buf.write_string(", ")
    }
    buf.write_string("ctx : @moonspec.Ctx")
  }
  buf.write_string(")" + lambda_effect(step) + " {\n")
  write_step_call(buf, step, typed.length(), takes_ctx~)
}

///|
/// Generate a handler registration for a step function that takes only
/// `Ctx`. The handler reads its own arguments, so no arity is checked.
fn generate_handler_step(buf : StringBuilder, step : StepFnInfo) -> Unit {
  buf.write_string(
    "  setup." +
    step.keyword +
    "(\"" +
    escape_pattern(step.pattern) +
    "\", fn(ctx)" +
    lambda_effect(step) +
    " {\n",
  )
  write_step_call(buf, step, 0, takes_ctx=true)
}

///|
/// Generate a handler registration that decodes each argument with
/// `FromStepArg`, for more typed parameters than a typed method takes.
fn generate_decoded_step(
  buf : StringBuilder,
  step : StepFnInfo,
  typed : Array[ParamInfo],
  takes_ctx~ : Bool,
) -> Unit {
  buf.write_string(
    "  setup." +
    step.keyword +
    "(\"" +
    escape_pattern(step.pattern) +
    "\", fn(ctx) raise {\n",
  )
  for i, param in typed {
    let idx = i.to_string()
    buf.write_string(
      "    let _arg" +
      idx +
      " : " +
      param.type_name +
      " = @moonspec.FromStepArg::from_step_arg(ctx[" +
      idx +
      "])\n",
    )
  }
  write_step_call(buf, step, typed.length(), takes_ctx~)
}

///|
fn escape_pattern(s : String) -> String {
  let buf = StringBuilder()
  for i = 0; i < s.length(); i = i + 1 {
    let c = s[i]
    if c == '"' {
      buf.write_string("\\\"")
    } else if c == '\\' {
      buf.write_string("\\\\")
    } else {
      buf.write_char(c.to_int().unsafe_to_char())
    }
  }
  buf.to_string()
}
