///|
test "generate_configure produces valid impl block" {
  let steps : Array[StepFnInfo] = [
    {
      keyword: "given",
      pattern: "I have {int} cucumbers",
      fn_name: "set_cucumbers",
      world_type: "MyWorld",
      params: [{ name: "count", type_name: "Int", }],
      is_method: true,
      raises: false,
      source_file: "src/steps.mbt",
      line: 2,
    },
  ]
  let output = generate_configure("MyWorld", steps, source_hash="abcd1234")
  // Check header
  assert_true(str_contains(output, "// Generated by moonspec gen steps"))
  assert_true(str_contains(output, "// moonspec:hash:abcd1234"))
  // Check impl block
  assert_true(
    str_contains(
      output, "impl @moonspec.World for MyWorld with configure(self, setup)",
    ),
  )
  // Only tests use the impl; silence the unused warning in non-test code
  assert_true(
    str_contains(
      output, "#warnings(\"-unused_value\")\nimpl @moonspec.World for MyWorld",
    ),
  )
  // Check typed step registration
  assert_true(str_contains(output, "setup.given1(\"I have {int} cucumbers\""))
  // Check typed lambda parameter
  assert_true(str_contains(output, "_arg0 : Int"))
  // Check function call
  assert_true(str_contains(output, "set_cucumbers(self, _arg0)"))
}

///|
test "generate_configure handles multiple params" {
  let steps : Array[StepFnInfo] = [
    {
      keyword: "when",
      pattern: "I eat {int} of {string}",
      fn_name: "eat_food",
      world_type: "W",
      params: [
        { name: "count", type_name: "Int", },
        { name: "food", type_name: "String", },
      ],
      is_method: true,
      raises: false,
      source_file: "src/steps.mbt",
      line: 5,
    },
  ]
  let output = generate_configure("W", steps, source_hash="00000000")
  // Check arity-suffixed method
  assert_true(str_contains(output, "setup.when2("))
  // Check typed lambda parameters
  assert_true(str_contains(output, "_arg0 : Int"))
  assert_true(str_contains(output, "_arg1 : String"))
  // Check function call with both args
  assert_true(str_contains(output, "eat_food(self, _arg0, _arg1)"))
}

///|
test "generate_configure handles no-param steps" {
  let steps : Array[StepFnInfo] = [
    {
      keyword: "when",
      pattern: "they log in",
      fn_name: "login",
      world_type: "W",
      params: [],
      is_method: true,
      raises: false,
      source_file: "src/steps.mbt",
      line: 3,
    },
  ]
  let output = generate_configure("W", steps, source_hash="00000000")
  // Check arity-0 method
  assert_true(str_contains(output, "setup.when0("))
  // Check empty lambda params
  assert_true(str_contains(output, "fn() {"))
  // Check function call
  assert_true(str_contains(output, "login(self)"))
}

///|
test "generate_configure falls back to ctx-based for arity > 22" {
  let params : Array[ParamInfo] = []
  for i = 0; i < 23; i = i + 1 {
    params.push({ name: "p" + i.to_string(), type_name: "Int", })
  }
  let steps : Array[StepFnInfo] = [
    {
      keyword: "given",
      pattern: "many params",
      fn_name: "many_params",
      world_type: "W",
      params,
      is_method: true,
      raises: false,
      source_file: "src/steps.mbt",
      line: 1,
    },
  ]
  let output = generate_configure("W", steps, source_hash="00000000")
  // Should use ctx-based fallback, not typed arity method
  assert_true(str_contains(output, "setup.given(\"many params\""))
  assert_true(str_contains(output, "fn(ctx) raise"))
  assert_true(
    str_contains(
      output, "let _arg0 : Int = @moonspec.FromStepArg::from_step_arg(ctx[0])",
    ),
  )
  // Should NOT use arity-suffixed method
  assert_true(!str_contains(output, "setup.given23("))
}

///|
test "generate_configure annotates raise only for raising steps" {
  let steps : Array[StepFnInfo] = [
    {
      keyword: "then",
      pattern: "I should have {int} todos",
      fn_name: "then_todo_count",
      world_type: "W",
      params: [{ name: "count", type_name: "Int", }],
      is_method: true,
      raises: true,
      source_file: "src/steps.mbt",
      line: 1,
    },
    {
      keyword: "given",
      pattern: "a todo list",
      fn_name: "given_todo_list",
      world_type: "W",
      params: [],
      is_method: true,
      raises: false,
      source_file: "src/steps.mbt",
      line: 5,
    },
  ]
  let output = generate_configure("W", steps, source_hash="00000000")
  // A step function that raises needs an explicit `raise` on its lambda
  assert_true(str_contains(output, "fn(_arg0 : Int) raise {"))
  assert_true(str_contains(output, "fn() {"))
  assert_true(!str_contains(output, "fn() raise {"))
}

///|
fn ctx_step(
  keyword : String,
  pattern : String,
  fn_name : String,
  params : Array[ParamInfo],
  raises~ : Bool,
) -> StepFnInfo {
  {
    keyword,
    pattern,
    fn_name,
    world_type: "W",
    params,
    is_method: false,
    raises,
    source_file: "src/steps.mbt",
    line: 1,
  }
}

///|
test "a step function that takes only Ctx registers as a handler" {
  let steps = [
    ctx_step(
      "given",
      "the users",
      "given_users",
      [{ name: "ctx", type_name: "@moonspec.Ctx", }],
      raises=true,
    ),
    ctx_step(
      "when",
      "they log in",
      "when_login",
      [{ name: "ctx", type_name: "Ctx", }],
      raises=false,
    ),
  ]
  let output = generate_configure("W", steps, source_hash="00000000")
  // The handler reads its arguments from ctx, so no arity is checked
  assert_true(
    str_contains(
      output, "setup.given(\"the users\", fn(ctx) raise {\n    given_users(self, ctx)\n  })",
    ),
  )
  assert_true(
    str_contains(
      output, "setup.when(\"they log in\", fn(ctx) {\n    when_login(self, ctx)\n  })",
    ),
  )
}

///|
test "typed parameters followed by Ctx use the _ctx variant" {
  let steps = [
    ctx_step(
      "when",
      "I log {string}",
      "when_log",
      [
        { name: "msg", type_name: "String", },
        { name: "ctx", type_name: "@moonspec.Ctx", },
      ],
      raises=false,
    ),
  ]
  let output = generate_configure("W", steps, source_hash="00000000")
  assert_true(
    str_contains(
      output, "setup.when1_ctx(\"I log {string}\", fn(_arg0 : String, ctx : @moonspec.Ctx) {\n    when_log(self, _arg0, ctx)\n  })",
    ),
  )
}

///|
test "more than four typed parameters with Ctx fall back to a handler" {
  let params : Array[ParamInfo] = []
  for i = 0; i < 5; i = i + 1 {
    params.push({ name: "p" + i.to_string(), type_name: "Int", })
  }
  params.push({ name: "ctx", type_name: "@moonspec.Ctx", })
  let steps = [ctx_step("then", "five", "then_five", params, raises=false)]
  let output = generate_configure("W", steps, source_hash="00000000")
  assert_true(str_contains(output, "setup.then(\"five\", fn(ctx) raise {"))
  assert_true(
    str_contains(
      output, "then_five(self, _arg0, _arg1, _arg2, _arg3, _arg4, ctx)",
    ),
  )
  assert_true(!str_contains(output, "then5_ctx"))
}
